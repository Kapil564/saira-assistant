# Windows Assistant — environment variables
# =====================================================================
# You do NOT need to fill everything in. Only fill the section for each
# provider you actually have. Anything left blank falls back to a free or
# local alternative automatically.
#
# Quick-start presets:
#   - No keys at all        → SAPI5 TTS, local Ollama LLM, local faster-whisper STT
#   - OpenAI key            → Whisper STT + GPT-4o-mini intent + SAPI5 TTS
#   - ElevenLabs key        → Premium voice TTS (STT/LLM fall back as above)
#   - Gemini key            → Gemini Flash intent (STT/TTS fall back as above)
#   - Groq key              → Fast Whisper STT + Llama intent + SAPI5 TTS
#   - Privacy mode          → Leave all API keys blank, run Ollama + faster-whisper locally
# =====================================================================

# === Speech-to-Text (STT) — pick ONE if you have a key ===
# If neither key is set, the app expects a local faster-whisper server at
# OFFLINE_STT_URL (see bottom).
OPENAI_API_KEY=
# === Intent model (LLM) — pick ONE if you have a key ===
# If none of these keys are set, the app falls back to local Ollama at
# OLLAMA_BASE_URL.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# === Text-to-Speech (TTS) — optional ===
# If no premium key is set, the app uses Windows SAPI5 (free, offline).
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=933563129e564b19a115bedd57b7406a
FISH_AUDIO_MODEL=s2.1-pro-free

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=C8uRRxxNZH0vRqJbVFJy

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# === Cloudflare Workers AI & AI Gateway ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_STT_MODEL=@cf/openai/whisper
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TTS_MODEL=elevenlabs/eleven-multilingual-v2

# === Memory & Context ===
MEM0_API_KEY=

# === Provider selection overrides (optional) ===
# Normally the app auto-selects based on which keys are present.
# Set these only if you want to force a specific provider.
# LLM_PROVIDER=openai|gemini|groq|ollama|cloudflare
# STT_PROVIDER=openai|groq|cloudflare
# TTS_PROVIDER=sapi5|fishaudio|elevenlabs|azure|cloudflare

# === Local / offline services ===
# Ollama is used automatically when no LLM API key is set.
OLLAMA_BASE_URL=http://localhost:11434

# Local faster-whisper server is used automatically when no STT API key is set.
OFFLINE_STT_URL=http://localhost:8000

# ===================================================================
# After editing this file, rename it to .env
# ===================================================================
